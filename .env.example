# OpenAI API Key (for Mastra agents)
OPENAI_API_KEY=

# ============================================
# Binance API Configuration
# ============================================

# API credentials (get from Binance API Management)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use testnet for development (true/false)
BINANCE_TESTNET=true

# ============================================
# Core Analytics API
# ============================================

# URL of the Core Analytics service
CORE_API_URL=http://localhost:3001

# API Key for Core Analytics
CORE_API_KEY=test-api-key-12345

# ============================================
# Risk Management
# ============================================

# Maximum % of balance to risk per position (default: 2)
MAX_POSITION_SIZE_PERCENT=2

# Maximum daily loss % before stopping trading (default: 5)
MAX_DAILY_LOSS_PERCENT=5

# Maximum number of simultaneous positions (default: 3)
MAX_OPEN_POSITIONS=3

# Minimum Risk:Reward ratio (default: 2)
MIN_RISK_REWARD=2

# Maximum leverage per position (default: 10)
MAX_LEVERAGE_PER_POSITION=10

# Default risk amount per trade in USD (default: 100)
DEFAULT_RISK_PER_TRADE_USD=100

# ============================================
# Scheduler
# ============================================

# Enable automated scheduling (default: false)
SCHEDULER_ENABLED=true

# Pre-US Market cron (default: 30 min before US open)
PRE_US_MARKET_CRON=30 13 * * 1-5

# Pre-Asia Market cron (default: midnight UTC)
PRE_ASIA_MARKET_CRON=0 0 * * *

# ============================================
# Trading
# ============================================

# Default symbols to trade (comma-separated)
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT

# Default fee percentage for position calculations
DEFAULT_FEE_PERCENT=0.07

MIN_CONFIDENCE_TO_TRADE=0.45
HARD_REJECT_CONFIDENCE=0.40

# ============================================
# Storage
# ============================================

# LibSQL database URL (default: file-based)
LIBSQL_URL=file:./trading.db

# Server port
PORT=3002

# Server admin API key
ADMIN_API_KEY=test12345
ADMIN_LOGIN=admin
ADMIN_PASSWORD=pass12345